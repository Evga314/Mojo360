{
	"schemaVersion": 1,
	"id": "mojo360",
	"version": "${version}",
	"name": "Mojo joystick 360",
	"description": "Brings 360° joystick movement to MojoLauncher. Requires my Mojo360 fork until my pull request is merged into MojoLauncher.",
	"authors": [
		"Evga314"
	],
	"contact": {
		"homepage": "https://github.com/Evga314",
		"sources": "https://github.com/Evga314/Mojo-joystick-360",
		"issues": "https://github.com/Evga314/Mojo-joystick-360/issues"
	},
	"license": "LGPL-3.0",
	"icon": "assets/mojo360/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ru.evga314.mojo360.Mojo360Client"
		],
		"modmenu": [
			"ru.evga314.mojo360.modmenu.Mojo360ModMenuApi"
		]
	},
	"mixins": [
		{
			"config": "mojo360.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*"
	}
}
